FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


transportModel  Newtonian;

nu              [0 2 -1 0 0 0 0] 0.0002827;


Sc             Sc [ 0 0 0 0 0 0 0 ] 700;
Sct             Sct [ 0 0 0 0 0 0 0 ] 700;


Fr             Fr [ 0 0 0 0 0 0 0 ] 10;

