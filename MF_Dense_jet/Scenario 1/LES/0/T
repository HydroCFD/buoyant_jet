FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }

    outlet
    {
        type            zeroGradient;
    }

    leftwall
    {
        type            zeroGradient;
    }

    rightwall
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }


    back2
    {
        type            zeroGradient;
    }



    top
    {
        type            zeroGradient;
    }


    ".*"
    {
        type            fixedValue;
        value           uniform 0;
    }



}

