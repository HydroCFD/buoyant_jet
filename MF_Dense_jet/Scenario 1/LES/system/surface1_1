sample1_1
{
    type            surfaces;
    libs            ("libsampling.so");
    writeControl    adjustableRunTime;
    writeInterval   5;
    surfaceFormat   vtk;
    fields          (U T p vorticity enstrophy Q Lambda2 LambVector kTot LESResIndex);
    interpolationScheme cellPoint;
    surfaces
    (
        surface1_1
        {
            type            cuttingPlane;
            planeType       pointAndNormal;
            pointAndNormalDict
            {
                point   (0 0 0);
                normal  (0 0 1);
            }
            interpolate     true;
        }
    );

}

